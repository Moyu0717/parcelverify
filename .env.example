# Set these as server environment variables or Streamlit Secrets.
# This file is a reference only; the app does not automatically load .env.
PV_AI_PROVIDER=gemini
PV_AI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
# Gemini uses its official default endpoint; no custom URL is needed.
# Optional persistent disk directory; default data/workspaces beside the app.
# PV_DATA_DIR=/persistent/parcelverify/workspaces
